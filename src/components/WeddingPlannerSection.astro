---
import { weddingConfig } from '../config/wedding.config';
import { withBase } from '../lib/paths';
import SectionHeading from './SectionHeading.astro';

const { weddingPlanner } = weddingConfig;
const photoUrl = withBase(weddingPlanner.photo);
---

<section id="wedding-planner" class="bg-ivory px-5 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-5xl">
    <SectionHeading
      eyebrow={weddingPlanner.eyebrow}
      title={weddingPlanner.title}
    />

    <div class="mt-16 grid items-center gap-10 lg:grid-cols-[0.8fr_1fr] lg:gap-16">
      <div class="reveal mx-auto w-full max-w-sm">
        <div class="overflow-hidden rounded-card border border-sand/60">
          <img
            src={photoUrl}
            alt={weddingPlanner.photoAlt}
            loading="lazy"
            decoding="async"
            width="640"
            height="640"
            class="aspect-square h-full w-full object-cover"
          />
        </div>
      </div>

      <div class="reveal">
        <h3 class="font-serif text-3xl text-ink">{weddingPlanner.name}</h3>
        <p class="mt-2 text-sm tracking-[0.18em] text-gold uppercase">
          {weddingPlanner.agency}
        </p>
        <p class="mt-1 text-sm text-muted">{weddingPlanner.role}</p>

        <p class="mt-6 text-base leading-relaxed text-muted">
          {weddingPlanner.description}
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            class="btn btn-primary"
            href={`tel:${weddingPlanner.phone.replace(/\s+/g, '')}`}
          >
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="h-4 w-4"
            >
              <path
                d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.24 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.24 1z"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            {weddingPlanner.phone}
          </a>
          <a class="btn btn-outline" href={`mailto:${weddingPlanner.email}`}>
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="h-4 w-4"
            >
              <rect x="3" y="5" width="18" height="14" rx="2"></rect>
              <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            {weddingPlanner.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
