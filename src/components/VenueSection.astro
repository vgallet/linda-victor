---
import { weddingConfig } from '../config/wedding.config';
import { withBase } from '../lib/paths';
import MapEmbed from './MapEmbed.astro';
import SectionHeading from './SectionHeading.astro';

const { venue, date } = weddingConfig;
---

<section id="lieu" class="bg-ivory px-5 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading
      eyebrow={venue.eyebrow}
      title={venue.title}
      description={venue.description}
    />

    <div class="mt-16 grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-16">
      <div class="reveal">
        <h3 class="font-serif text-3xl text-ink">{venue.name}</h3>

        <address class="mt-4 space-y-1 text-base leading-relaxed text-muted not-italic">
          {venue.addressLines.map((line) => <span class="block">{line}</span>)}
        </address>

        <p class="mt-6 text-sm tracking-[0.18em] text-gold uppercase">{date.longLabel}</p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="btn btn-primary"
            href={venue.googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Itinéraire Google Maps
          </a>
          <a
            class="btn btn-outline"
            href={venue.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            Site du domaine
          </a>
        </div>
      </div>

      <div class="reveal">
        <MapEmbed embedUrl={venue.mapEmbedUrl} title={`Carte d’accès à ${venue.name}`} />
      </div>
    </div>

    {
      venue.gallery.length > 0 && (
        <div class="mt-14">
          <ul class="grid grid-cols-2 gap-4 sm:gap-5 lg:grid-cols-4">
            {venue.gallery.map((photo) => (
              <li class="reveal group relative aspect-[4/3] overflow-hidden rounded-card">
                <img
                  src={withBase(photo.src)}
                  alt={photo.alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>
