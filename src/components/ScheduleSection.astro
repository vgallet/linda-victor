---
import { weddingConfig } from '../config/wedding.config';
import ScheduleIcon from './ScheduleIcon.astro';
import SectionHeading from './SectionHeading.astro';

const { schedule } = weddingConfig;
---

<section id="programme" class="bg-shell/40 px-5 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-4xl">
    <SectionHeading
      eyebrow={schedule.eyebrow}
      title={schedule.title}
      description={schedule.underConstruction ? undefined : schedule.description}
    />

    {
      schedule.underConstruction ? (
        <div class="reveal mx-auto mt-16 max-w-xl rounded-2xl border border-sand bg-ivory/70 px-8 py-12 text-center">
          <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full border border-sand bg-shell/60 text-sage-dark">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              class="h-6 w-6"
            >
              <path d="M12 8v4l2.5 2.5" stroke-linecap="round" stroke-linejoin="round" />
              <circle cx="12" cy="12" r="9" />
            </svg>
          </span>
          <p class="mt-6 text-base leading-relaxed text-muted">{schedule.constructionMessage}</p>
        </div>
      ) : (
        <ol class="relative mt-16">
          {/* Vertical guide line, hidden on small screens where the layout stacks. */}
          <span
            aria-hidden="true"
            class="absolute top-2 bottom-2 left-6 w-px bg-sand sm:left-1/2 sm:-translate-x-1/2"
          />

          {schedule.entries.map((entry, index) => {
            const isEven = index % 2 === 0;
            return (
              <li class="reveal relative pb-12 pl-16 last:pb-0 sm:grid sm:grid-cols-2 sm:gap-12 sm:pl-0">
                <span class="absolute left-0 flex h-12 w-12 items-center justify-center rounded-full border border-sand bg-ivory text-sage-dark sm:left-1/2 sm:-translate-x-1/2">
                  <ScheduleIcon name={entry.icon} class="h-5 w-5" />
                </span>

                <div
                  class:list={[
                    'sm:col-span-1',
                    isEven ? 'sm:pr-16 sm:text-right' : 'sm:col-start-2 sm:pl-16',
                  ]}
                >
                  <p class="text-sm tracking-[0.24em] text-gold uppercase">{entry.time}</p>
                  <h3 class="mt-2 font-serif text-2xl text-ink">{entry.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-muted">{entry.description}</p>
                </div>
              </li>
            );
          })}
        </ol>
      )
    }
  </div>
</section>
