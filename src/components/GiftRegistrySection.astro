---
import { weddingConfig } from '../config/wedding.config';
import SectionHeading from './SectionHeading.astro';

const { giftRegistry } = weddingConfig;
---

<section id="cagnotte" class="bg-shell/40 px-5 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-4xl">
    <SectionHeading
      eyebrow={giftRegistry.eyebrow}
      title={giftRegistry.title}
      description={giftRegistry.description}
    />

    <ul
      class:list={[
        'mt-14 grid gap-6',
        giftRegistry.links.length > 1 ? 'sm:grid-cols-2' : 'mx-auto max-w-md',
      ]}
    >
      {
        giftRegistry.links.map((link) => (
          <li class="reveal">
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-full flex-col rounded-card border border-sand/60 bg-ivory p-8 transition-colors hover:border-sage-dark"
            >
              <h3 class="font-serif text-2xl text-ink">{link.label}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{link.description}</p>
              <span class="mt-6 text-xs tracking-[0.18em] text-sage-dark uppercase">
                Découvrir →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
