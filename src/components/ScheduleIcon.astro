---
import type { ScheduleIconName } from '../config/types';

interface Props {
  name: ScheduleIconName;
  class?: string;
}

const { name, class: className } = Astro.props;

/** Single-path line icons, drawn on a 24x24 grid. */
const ICON_PATHS: Record<ScheduleIconName, string[]> = {
  welcome: ['M4 20v-1a5 5 0 0 1 5-5h6a5 5 0 0 1 5 5v1', 'M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z'],
  ceremony: [
    'M12 3v18',
    'M7.5 9.5a4.5 4.5 0 0 1 9 0c0 3-4.5 6.5-4.5 6.5S7.5 12.5 7.5 9.5Z',
    'M5 21h14',
  ],
  photos: [
    'M3 8.5A2.5 2.5 0 0 1 5.5 6h1.7l1.2-2h7.2l1.2 2h1.7A2.5 2.5 0 0 1 21 8.5v9A2.5 2.5 0 0 1 18.5 20h-13A2.5 2.5 0 0 1 3 17.5v-9Z',
    'M12 16.5a3.75 3.75 0 1 0 0-7.5 3.75 3.75 0 0 0 0 7.5Z',
  ],
  cocktail: ['M4 5h16l-8 8v7', 'M8 20h8', 'M6.5 8.5h11'],
  dinner: ['M6 3v9a2 2 0 0 0 4 0V3', 'M8 12v9', 'M17 3c-1.5 2-2 3.5-2 6h4c0-2.5-.5-4-2-6Z', 'M17 9v12'],
  party: [
    'M4 20l5.5-11L15 14.5 4 20Z',
    'M14 4.5 15 6',
    'M18.5 5.5 17 7',
    'M20 10h-2',
    'M13 9.5 19.5 3',
  ],
  brunch: ['M4 11h13a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4Z', 'M17 11h1.5a2 2 0 1 1 0 4H17', 'M3 19h16'],
};
---

<svg
  aria-hidden="true"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
>
  {ICON_PATHS[name].map((path) => <path d={path} />)}
</svg>
