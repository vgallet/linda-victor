---
import { weddingConfig } from '../config/wedding.config';
import SectionHeading from './SectionHeading.astro';

const { playlist } = weddingConfig;
---

<section id="playlist" class="bg-ivory px-5 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-2xl text-center">
    <SectionHeading
      eyebrow={playlist.eyebrow}
      title={playlist.title}
      description={playlist.description}
    />

    <div class="reveal mt-12">
      <a
        href={playlist.playlistUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="h-4 w-4"
        >
          <path d="M9 18V5l10-2v13" stroke-linecap="round" stroke-linejoin="round"></path>
          <circle cx="6" cy="18" r="3"></circle>
          <circle cx="16" cy="16" r="3"></circle>
        </svg>
        {playlist.playlistLabel}
      </a>
    </div>
  </div>
</section>
