---
import { weddingConfig } from '../config/wedding.config';

const { couple, date, venue, rsvp } = weddingConfig;
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-sand/60 bg-shell/60">
  <div class="mx-auto max-w-6xl px-5 py-14 text-center sm:px-8">
    <p class="font-serif text-3xl text-ink">
      {couple.partnerOne} <span class="text-gold">&</span> {couple.partnerTwo}
    </p>
    <p class="mt-3 text-sm text-muted">
      {date.longLabel} — {venue.name}, {venue.city}
    </p>

    {
      couple.hashtag && (
        <p class="mt-6 text-xs tracking-[0.24em] text-gold uppercase">#{couple.hashtag}</p>
      )
    }

    <p class="mt-8 text-sm text-muted">
      Une question ?{' '}
      <a class="underline underline-offset-4 hover:text-sage-dark" href={`mailto:${rsvp.contactEmail}`}>
        {rsvp.contactEmail}
      </a>
    </p>

    <p class="mt-10 text-xs tracking-[0.18em] text-muted/70 uppercase">
      © {currentYear} — Fait avec amour
    </p>
  </div>
</footer>
