---
interface Props {
  /** Google Maps embed URL, only requested once the guest asks for it. */
  embedUrl: string;
  /** Accessible title of the generated iframe. */
  title: string;
}

const { embedUrl, title } = Astro.props;
---

{/*
  Privacy-friendly map: nothing is requested from Google until the guest
  explicitly clicks "Afficher la carte", so no third-party cookie is set
  on page load and no consent banner is required.
*/}
<div
  data-map-embed
  data-map-src={embedUrl}
  data-map-title={title}
  class="relative aspect-[4/3] w-full overflow-hidden rounded-card border border-sand/70 bg-shell sm:aspect-[16/10]"
>
  <div
    data-map-facade
    class="absolute inset-0 flex flex-col items-center justify-center gap-4 bg-[radial-gradient(circle_at_30%_20%,#f3ebe1,transparent_60%),radial-gradient(circle_at_75%_75%,#e6d8c8,transparent_55%)] p-6 text-center"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      class="h-9 w-9 text-sage-dark"
    >
      <path
        d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </svg>

    <button type="button" data-map-load class="btn btn-outline bg-ivory/80">
      Afficher la carte
    </button>

    <p class="max-w-xs text-xs leading-relaxed text-muted">
      La carte est fournie par Google Maps. Elle ne se charge qu’après votre clic.
    </p>
  </div>
</div>

<script>
  for (const container of document.querySelectorAll<HTMLElement>('[data-map-embed]')) {
    const trigger = container.querySelector<HTMLButtonElement>('[data-map-load]');
    const facade = container.querySelector<HTMLElement>('[data-map-facade]');

    trigger?.addEventListener(
      'click',
      () => {
        const source = container.dataset.mapSrc;
        if (!source) return;

        const iframe = document.createElement('iframe');
        iframe.src = source;
        iframe.title = container.dataset.mapTitle ?? 'Carte';
        iframe.loading = 'lazy';
        iframe.referrerPolicy = 'no-referrer-when-downgrade';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 h-full w-full border-0';

        container.append(iframe);
        facade?.remove();
      },
      { once: true },
    );
  }
</script>
