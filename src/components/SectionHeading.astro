---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Centers the block, which is the default for every section. */
  align?: 'center' | 'start';
}

const { eyebrow, title, description, align = 'center' } = Astro.props;
const isCentered = align === 'center';
---

<div class:list={['reveal max-w-2xl', isCentered && 'mx-auto text-center']}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="mt-4 text-4xl text-ink sm:text-5xl">{title}</h2>
  <div class:list={['mt-6 h-px w-16 bg-gold/60', isCentered && 'mx-auto']}></div>
  {description && <p class="mt-6 text-base leading-relaxed text-muted">{description}</p>}
</div>
